# Copia este archivo como ".env" y llena los valores reales.
# NUNCA subas el archivo ".env" real a GitHub (ya está en .gitignore).

# --- Base de datos ---
# Para XAMPP local:
#   DB_HOST=localhost / DB_USER=root / DB_PASSWORD= / DB_PORT=3306 / DB_SSL=false
# Para Aiven (nube), estos datos te los da el panel de Aiven -> "Connection details":
DB_HOST=tu-host-de-aiven.aivencloud.com
DB_USER=avnadmin
DB_PASSWORD=tu_password_de_aiven
DB_NAME=bd_logistica_pro
DB_PORT=12345
DB_SSL=true

# --- Autenticación ---
JWT_SECRET=cambia_esto_por_un_texto_largo_y_secreto

# --- CORS / Frontend ---
# URL pública donde quede publicado tu frontend (Vercel). Déjalo vacío en local.
FRONTEND_URL=https://tu-frontend.vercel.app

# --- Puerto del servidor ---
# Render asigna su propio PORT automáticamente, no hace falta tocarlo en producción.
PORT=5000
